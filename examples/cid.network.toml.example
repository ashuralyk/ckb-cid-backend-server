# Example CID Server config (one file = one network).
# Copy, replace EVERY <PLACEHOLDER>, then:
#   cargo run -p cid-backend-daemon -- --config /path/to/your.toml
#
# Placeholders are NOT valid hex / URLs. This file cannot run as-is and
# does not target public testnet/mainnet.
#
# network.name is a log label only. Chain identity is genesis_hash
# (this network's get_block_hash 0x0). It is DECLARED, not verified,
# unless validate_genesis = true (then the daemon fail-closes on mismatch
# or RPC error).
#
# Contract code discovery (preferred for hash_type=type deployments):
#   type_id_args = 32-byte TYPE_ID type-script args on the CODE cell
#   type_id      = optional full type-script hash (calc_script_hash of
#                  built-in TYPE_ID + type_id_args). Fail-closed check only.
#   NEVER put a full type_id hash into type_id_args.
# Live Process *state* cells are still found by process_type_hash from CID
# args (full type script hash) + process type code_hash prefixes — that is
# not the same as the Process CODE cell's TYPE_ID identity.
# Daemon never loads dispatcher deployment JSON and never auto-discovers
# from chain without these configured identities. No keys. No signing.

[network]
name = "<NETWORK_LABEL>"
genesis_hash = "<GENESIS_BLOCK_HASH_32>"
validate_genesis = false

[rpc]
url = "<CKB_NODE_JSON_RPC_URL>"
# indexer_url = "<CKB_INDEXER_JSON_RPC_URL>"  # omit to use url

[cid_lock]
# Type-ID deploy (hash_type=type): set type_id_args; code_hash is derived.
type_id_args = "<CID_LOCK_TYPE_ID_ARGS_32>"
type_id = "<CID_LOCK_TYPE_ID_FULL_HASH_32>"   # optional verify; must match derived
# Legacy / local data1 fixtures (no Type-ID discovery for this role):
# code_hash = "<CID_LOCK_CODE_HASH_32>"
# hash_type = "data1"
# Bounded Incompatible refund fee (≤ 0.01 CKB / Intention). Default false =
# exact refund for currently deployed locks. Enable ONLY after OWNER redeploy
# of a lock that accepts the window; never against an undeployed candidate.
# See docs/refund-fee-migration.md. Contract candidate is not final.
# bounded_refund_fee = false

[process]
# Process CODE cell Type ID (not the live Process state cell).
type_id_args = "<PROCESS_CODE_TYPE_ID_ARGS_32>"
type_id = "<PROCESS_CODE_TYPE_ID_FULL_HASH_32>"  # optional verify
# Extra indexer prefixes if needed; derived type_id is auto-added when
# type_id_args is set.
# type_code_hashes = ["<PROCESS_TYPE_CODE_HASH_32>"]

# Optional: Process *lock* code cell via Type ID (e.g. always-success on chain).
# [process_lock]
# type_id_args = "<PROCESS_LOCK_TYPE_ID_ARGS_32>"
# type_id = "<PROCESS_LOCK_TYPE_ID_FULL_HASH_32>"

# Static extras only (secp, xUDT, local always-success, etc.).
# Do NOT set label = "cid_lock" / "process_code" / "process_lock" when that
# role uses type_id_args — config load rejects the conflict (stale outpoints
# after upgrades). Unlabeled extras cannot be inferred as role code cells.
# Same outpoint with a different dep_type vs a Type-ID dep also fails closed.
# [[cell_deps]]
# label = "xudt"
# tx_hash = "<XUDT_CODE_CELL_TX>"
# index = 0
# dep_type = "code"

[loop]
poll_interval_secs = 5
confirmation_depth = 24
# Shannons per 1000 bytes (KW). digest_ok pays by reducing Process recreate
# capacity (no fee input). Default 1000. Must be > 0 and <= 10000000.
# fee_rate = 1000

[observe]
# health_bind = "127.0.0.1:9100"           # omit/empty disables HTTP
log_format = "json"                        # json | pretty | text
